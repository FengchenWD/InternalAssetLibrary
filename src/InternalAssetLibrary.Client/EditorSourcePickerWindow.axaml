<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InternalAssetLibrary.Client.EditorSourcePickerWindow"
        Title="选择打开来源"
        Width="680"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="12">
    <StackPanel>
      <TextBlock Text="选择打开来源" Classes="pageTitle" FontSize="22" />
      <TextBlock Text="可以从电脑文件或本地素材库打开一个视频或音频。" Classes="muted" Margin="0,5,0,0" />
    </StackPanel>
    <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Left" Click="ChooseComputerFile_OnClick">从电脑选择文件</Button>
    <Border Grid.Row="2" Classes="glass" Padding="10">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Text="本地素材库中的视频或音频" Classes="sectionTitle" />
        <ListBox x:Name="LocalVideoList" Grid.Row="1" ItemsSource="{Binding Choices}" SelectionChanged="LocalVideoList_OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="4" MinHeight="36">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="muted" VerticalAlignment="Center" Margin="12,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="quiet" Click="Cancel_OnClick">取消</Button>
      <Button x:Name="ConfirmButton" Classes="accent" IsEnabled="False" Click="Confirm_OnClick">打开选中素材</Button>
    </StackPanel>
  </Grid>
</Window>
