<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InternalAssetLibrary.Client"
        x:Class="InternalAssetLibrary.Client.TagPickerWindow"
        x:DataType="vm:TagPickerWindow"
        Title="选择标签"
        Width="620"
        Height="590"
        MinWidth="520"
        MinHeight="480"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Border.tagItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.tagItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.tagDelete">
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tagDelete:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="DialogContent"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        Margin="24">
    <StackPanel>
      <TextBlock Text="{Binding DialogTitle}" Classes="pageTitle" FontSize="22" />
      <TextBlock Text="{Binding Description}"
                 Classes="muted"
                 Margin="0,6,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid x:Name="CreateTagPanel"
          Grid.Row="1"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8"
          Margin="0,20,0,0">
      <TextBox x:Name="NewTagNameBox"
               Watermark="输入新标签名称"
               MaxLength="32"
               KeyDown="NewTagNameBox_OnKeyDown" />
      <Button Grid.Column="1"
              Classes="accent"
              MinWidth="88"
              Click="CreateTag_OnClick">添加</Button>
    </Grid>

    <TextBox x:Name="SearchBox"
             Grid.Row="2"
             Margin="0,12,0,0"
             Watermark="搜索已有标签"
             TextChanged="SearchBox_OnTextChanged" />

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12"
            CornerRadius="10"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding VisibleItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TagPickerItemViewModel">
                <Border Classes="tagItem" IsEnabled="{Binding IsInteractive}">
                  <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding UsageText}"
                               Classes="muted"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasUsageCount}" />
                    <Button Grid.Column="2"
                            Classes="tagDelete"
                            Content="删除"
                            IsVisible="{Binding CanDelete}"
                            Click="DeleteTag_OnClick" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText"
                   Text="还没有可选标签，请先添加一个。"
                   Classes="muted"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="False" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="SelectionSummaryText" Classes="muted" />
        <TextBlock x:Name="StatusText"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="0,4,12,0"
                   TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="quiet" Click="Cancel_OnClick">取消</Button>
        <Button Classes="accent" Click="Confirm_OnClick">保存</Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
