<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InternalAssetLibrary.Client.AdminPasswordResetWindow"
        Title="重置密码"
        Width="440"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22" RowSpacing="12">
    <TextBlock Text="设置临时密码" Classes="pageTitle" />
    <TextBlock Grid.Row="1" Text="用户下次登录时会收到修改密码建议。" Classes="muted" TextWrapping="Wrap" />
    <TextBox Grid.Row="2" x:Name="PasswordBox" PasswordChar="●" MaxLength="128" Watermark="8 至 128 位临时密码" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8">
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
      <Button Classes="quiet" Click="Cancel_OnClick">取消</Button>
      <Button Classes="accent" Click="Save_OnClick">确认重置</Button>
    </StackPanel>
  </Grid>
</Window>
