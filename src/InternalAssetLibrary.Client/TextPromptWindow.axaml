<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InternalAssetLibrary.Client.TextPromptWindow"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="22">
    <StackPanel>
      <TextBlock x:Name="PromptTitle" Classes="sectionTitle" />
      <TextBlock x:Name="PromptDescription"
                 Margin="0,5,0,0"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>
    <TextBox x:Name="ValueBox"
             Grid.Row="1"
             Margin="0,18,0,0"
             MaxLength="500"
             KeyDown="ValueBox_OnKeyDown" />
    <StackPanel Grid.Row="2"
                Margin="0,18,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Classes="quiet" Click="Cancel_OnClick">取消</Button>
      <Button Classes="accent" Click="Confirm_OnClick">确定</Button>
    </StackPanel>
  </Grid>
</Window>
