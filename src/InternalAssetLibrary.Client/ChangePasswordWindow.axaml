<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InternalAssetLibrary.Client.ChangePasswordWindow"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        Title="修改密码">
  <Grid x:Name="DialogContent" RowDefinitions="Auto,Auto,Auto" Margin="22">
    <StackPanel Spacing="5">
      <TextBlock Text="修改密码" Classes="sectionTitle" />
      <TextBlock Text="密码必须为 8 至 128 位，且至少包含大写字母、小写字母、数字、特殊符号中的两种。"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="12">
      <StackPanel Spacing="5">
        <TextBlock Text="当前密码" Classes="muted" />
        <TextBox x:Name="CurrentPasswordBox" PasswordChar="*" MaxLength="128" />
      </StackPanel>
      <StackPanel Spacing="5">
        <TextBlock Text="新密码" Classes="muted" />
        <TextBox x:Name="NewPasswordBox" PasswordChar="*" MaxLength="128" />
      </StackPanel>
      <StackPanel Spacing="5">
        <TextBlock Text="确认新密码" Classes="muted" />
        <TextBox x:Name="ConfirmPasswordBox" PasswordChar="*" MaxLength="128" KeyDown="ConfirmPasswordBox_OnKeyDown" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="2"
                Margin="0,18,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button x:Name="CancelButton" Classes="quiet" Click="Cancel_OnClick">取消</Button>
      <Button x:Name="SaveButton" Classes="accent" Click="Save_OnClick">保存</Button>
    </StackPanel>
  </Grid>
</Window>
