<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InternalAssetLibrary.Client.PlaybackShortcutSettingsWindow"
        Title="播放器快捷键"
        Width="620"
        Height="720"
        MinWidth="520"
        MinHeight="560"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        KeyDown="Window_OnKeyDown">
  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14" Margin="22">
    <StackPanel Spacing="5">
      <TextBlock Text="播放器快捷键" Classes="pageTitle" />
      <TextBlock Text="点击快捷键按钮，再按下新的组合键；输入文字时不会触发播放器快捷键。"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <TextBlock Text="{Binding ActionLabel}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        MinWidth="150"
                        Classes="quiet"
                        Tag="{Binding Action}"
                        Content="{Binding GestureLabel}"
                        Click="ShortcutButton_OnClick" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="ShortcutStatusText"
               Grid.Row="2"
               MinHeight="22"
               Classes="muted"
               TextWrapping="Wrap" />

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button Classes="quiet" Click="RestoreDefaults_OnClick">恢复默认</Button>
      <Button Grid.Column="2" Classes="quiet" Click="Cancel_OnClick">取消</Button>
      <Button Grid.Column="3" Classes="accent" Click="Save_OnClick">保存</Button>
    </Grid>
  </Grid>
</Window>
